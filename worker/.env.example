# Environment for the 3D conversion worker (spec 009-photo-to-3d-model).
# Copy to worker/.env — that file is git-ignored.

SUPABASE_URL=

# Server-only. NEVER put this in the repo, in the browser's .env.local, or anywhere in src/.
# It bypasses Row Level Security so the worker can claim jobs and write model files.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Hugging Face Space that turns an image into a .glb (stable-fast-3d). No API key.
# SF3D_API_URL=https://ahmad-sarmad-ali-3d-model-ai.hf.space/generate-3d/

POLL_SECONDS=10
