{
  "name": "photo-organizer",
  "version": "1.0.0",
  "description": "A local photo organizer web application for organizing handcraft work photos into date-grouped albums",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "piexifjs": "^1.0.6",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.54.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.1.0",
    "terser": "^5.51.2",
    "vite": "^4.5.0",
    "vitest": "^1.0.0"
  }
}
